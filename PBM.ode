# Transcribed from references/SKNM_code/PBM.h (gotran-generated C++)
# Phantom bursting model of the pancreatic beta cell, Bertram & Sherman,
# Bull Math Biol 66:1313-1344 (2004).  Parameterisation as used by
# Jaeger & Tveito, Sci Rep 13:16434 (2023).
# Generated by tools/c2ode.py -- do not edit by hand.

parameters("Ca2+ current",
gca = 1200,
sm = 12,
vca = 25,
vm = -20
)

parameters("Delayed-rectifying K+ current",
gk = 3000,
sn = 5,
vk = -75,
vn = -16
)

parameters("Ca2+-activated K+ current",
gkca = 10,
kd = 0.3
)

parameters("K-atp channel current",
Dz = 1,
G = 11,
gkatpbar = 500,
kr = 58,
pr = 1.75,
sa = 0.1
)

parameters("Ca2+ fluxes across the plasma membrane",
alpha = 4.5e-06,
kpmca = 0.2
)

parameters("Ca2+ fluxes into ER",
kserca = 0.4,
pleak = 0.0005
)

parameters("Electrical and Calcium Model",
Cm = 5300,
fca = 0.01,
sigmaer = 5,
taun = 16,
taua = 300000
)

states("Electrical and Calcium Model",
v = -66,
n = 0,
c = 0.1,
a = 0.52,
cer = 110
)

expressions("Ca2+ current")
minf = 1.0 / (1.0 + exp((vm - v) / sm))
ica = gca * (-vca + v) * minf

expressions("Delayed-rectifying K+ current")
ninf = 1.0 / (1.0 + exp((vn - v) / sn))
ik = gk * (-vk + v) * n

expressions("Ca2+-activated K+ current")
omega = c ** 5.0 / (kd ** 5.0 + c ** 5.0)
ikca = gkca * (-vk + v) * omega

expressions("K-atp channel current")
r = (G - pr) / kr
ainf = 1.0 / (1.0 + exp((-c + r) / sa))
ikatp = Dz * gkatpbar * (-vk + v) * a

expressions("Ca2+ fluxes across the plasma membrane")
jpmca = kpmca * c
jmem = -jpmca - alpha * ica

expressions("Ca2+ fluxes into ER")
jserca = kserca * c
jerleak = pleak * (-c + cer)
jer = -jserca + jerleak

expressions("Electrical and Calcium Model")
dv_dt = (-ica - ik - ikatp - ikca) / Cm
dn_dt = (-n + ninf) / taun
dc_dt = fca * (jer + jmem)
da_dt = (-a + ainf) / taua
dcer_dt = -fca * sigmaer * jer
