)

expressions("Reversal potentials")
FoRT = Frdy / (R * Temp)
ena = log(Nao / Na_i) / FoRT
ek = log(Ko / K_i) / FoRT
eca_sl = log(ce / csl) / (2.0 * FoRT)
ecl = log(Cli / Clo) / FoRT
Qpow = -31.0 + 0.1 * Temp

expressions("I_Na")
mss = 1.0 / ((1.0 + exp(-19.0 / 3.0 - V_m / 9.0)) * (1.0 + exp(-19.0 / 3.0 - V_m / 9.0)))
taum = Q10Na ** (-Qpow) * (0.06 * exp(-((-5.0 / 51.0 + V_m / 51.0) * (-5.0 / 51.0 + V_m / 51.0))) + 0.13 * exp(-((23.0 / 8.0 + V_m / 16.0) * (23.0 / 8.0 + V_m / 16.0))))
aj = Conditional(Ge(V_m, -40.0), 0.0, (38.0 + V_m) * (-25000.0 * exp(0.2 * V_m) - 7e-06 * exp(-0.04 * V_m)) / (1.0 + 19623624323.6513 * exp(0.3 * V_m)))
bj = Conditional(Ge(V_m, -40.0), 0.6 * exp(0.09 * V_m) / (1.0 + exp(-40.0 - V_m)), 0.02 * exp(-0.01 * V_m) / (1.0 + 0.00369786371648293 * exp(-0.14 * V_m)))
tauj = Q10Na ** (-Qpow) / (aj + bj)
jss = 1.0 / ((1.0 + exp(72.0 / 7.0 + V_m / 7.0)) * (1.0 + exp(72.0 / 7.0 + V_m / 7.0)))
dm_dt = (-m + mss) / taum
dj_dt = (-j + jss) / tauj
I_Na = g_Na * (m * m * m) * (-ena + V_m) * j

expressions("I_NaL")
mLss = 1.0 / (1.0 + exp(-43.0 / 5.0 - V_m / 5.0))
tm = 1.0 / (8.6 * exp(-77.0 / 6.0 - V_m / 6.0) + 6.8 * exp(12.0 / 35.0 + V_m / 35.0))
tmL = Q10NaL ** (-Qpow) * tm
dmL_dt = (-mL + mLss) / tmL
hLss = 1.0 / (1.0 + 124658.506952443 * exp(0.133333333333333 * V_m))
thLc = thL * Q10NaL ** (-Qpow)
dhL_dt = (-hL + hLss) / thLc
GNaL = g_NaL
I_NaL = (-ena + V_m) * GNaL * hL * mL

expressions("I_NaK")
sigma = -1.0 / 7.0 + exp(Nao / 67.0) / 7.0
fNaK = 1.0 / (1.0 + 0.12 * exp(-0.1 * FoRT * V_m) + 0.037 * exp(-FoRT * V_m) * sigma)
I_NaK = Ko * g_NaK * Q10NaK ** Qpow * fNaK / ((1.0 + KmNaip ** 4.0 * Q10K_Nai ** (4.0 * Qpow) / Na_i ** 4.0) * (KmKo + Ko))

expressions("I_Kr")
Xr1_inf = 1.0 / (1.0 + 1.19299933802777 * exp(-0.065359477124183 * V_m))
alpha_Xr1 = 450.0 / (1.0 + 0.0111089965382423 * exp(-0.1 * V_m))
beta_Xr1 = 6.0 / (1.0 + 13.5813245225782 * exp(0.0869565217391304 * V_m))
tau_Xr1 = 1.0 * Q10Kr_act ** (-Qpow) * alpha_Xr1 * beta_Xr1
dXr1_dt = (-Xr1 + Xr1_inf) / tau_Xr1
Xr2_infinity = Conditional(SQT1, 1.0 / (1.0 + 1.22986630710151 * exp(0.0258631837579206 * V_m)), 1.0 / (1.0 + 28.4822844754635 * exp(0.0478468899521531 * V_m)))
alpha_Xr2 = 3.0 / (1.0 + 0.0497870683678639 * exp(-0.05 * V_m))
beta_Xr2 = 1.12 / (1.0 + 0.0497870683678639 * exp(0.05 * V_m))
tau_Xr2 = 1.0 * Q10Kr_inact ** (-Qpow) * alpha_Xr2 * beta_Xr2
dXr2_dt = (-Xr2 + Xr2_infinity) / tau_Xr2
I_Kr = 0.430331482911935 * g_Kr * sqrt(Ko) * (-ek + V_m) * Xr1 * Xr2

expressions("I_Ks")
eks = log((Ko + Nao * pNaK) / (K_i + pNaK * Na_i)) / FoRT
xsss = 1.0 / (1.0 + 0.762289730789954 * exp(-V_m / 14.0))
tauxs = 990.0 * Q10Ks ** (-Qpow) / (1.0 + 0.842460441616771 * exp(-V_m / 14.0))
dx_Ks_dt = (-x_Ks + xsss) / tauxs
I_Ks = g_Ks * (x_Ks * x_Ks) * (-eks + V_m)

expressions("I_to")
q_inf = 1.0 / (1.0 + 58.9637634804245 * exp(0.0769230769230769 * V_m))
tau_q = Q10to ** (-Qpow) * (6.0 + 39.0 / (0.0168716780456984 * exp(-0.08 * V_m) + 6.4664805167257 * exp(0.1 * V_m)))
dq_dt = (-q + q_inf) / tau_q
r_inf = 1.0 / (1.0 + 3.28489055021172 * exp(-0.0533333333333333 * V_m))
tau_r = Q10to ** (-Qpow) * (2.75 + 14.4 / (0.0207698622486295 * exp(-0.12 * V_m) + 15.7194688773159 * exp(0.09 * V_m)))
dr_dt = (-r + r_inf) / tau_r
I_to = g_to * (-ek + V_m) * q * r

expressions("I_K1")
aK1 = 1.0 / (1.0 + 7.50455791507686e-06 * exp(0.2 * V_m - 0.2 * ek))
bK1 = (0.745912348820635 * exp(0.08 * V_m - 0.08 * ek) + 3.32464030033236e-16 * exp(0.06 * V_m - 0.06 * ek)) / (1.0 + 0.0820849986238988 * exp(0.5 * ek - 0.5 * V_m))
K1ss = aK1 / (aK1 + bK1)
I_K1 = 0.430331482911935 * g_K1 * sqrt(Ko) * (-ek + V_m) * K1ss

expressions("I_bCl")
I_bCl = g_bCl * (-ecl + V_m)

expressions("I_CaL")
fss = 1.0 / (1.0 + 48.8565712749872 * exp(0.111111111111111 * V_m)) + 0.6 / (1.0 + 12.1824939607035 * exp(-0.05 * V_m))
dss = 1.0 / (1.0 + 0.434598208507078 * exp(-0.166666666666667 * V_m))
taud = (1.0 - 0.434598208507078 * exp(-0.166666666666667 * V_m)) * dss / (0.175 + 0.035 * V_m)
tauf = 1.0 / (0.02 + 0.02 * exp(-((0.493 + 0.034 * V_m) * (0.493 + 0.034 * V_m))))
dd_dt = (-d + dss) / taud
df_dt = (-f + fss) / tauf
df_Ca_dt = -0.012 * f_Ca + 1.7 * (1.0 - f_Ca) * cd
ibarca_j = 4.0 * Frdy * g_CaL * (-0.34 * ce + 0.34 * cd * exp(2.0 * FoRT * V_m)) * FoRT * V_m / (-1.0 + exp(2.0 * FoRT * V_m))
I_CaL = Q10CaL ** Qpow * (1.0 - f_Ca) * d * f * ibarca_j

expressions("I_NaCa")
Ka_sl = 1.0 / (1.0 + Kdact * Kdact / (csl * csl))
s1_sl = ce * (Na_i * Na_i * Na_i) * exp(nu * FoRT * V_m)
s2_sl = Nao * Nao * Nao * csl * exp((-1.0 + nu) * FoRT * V_m)
s3_sl = KmCao * (Na_i * Na_i * Na_i) + ce * (Na_i * Na_i * Na_i) + Nao * Nao * Nao * csl + KmCai * (Nao * Nao * Nao) * (1.0 + Na_i * Na_i * Na_i / (KmNai * KmNai * KmNai)) + KmNao * KmNao * KmNao * (1.0 + csl / KmCai) * csl
I_NaCa = g_NaCa * Q10NaCa ** Qpow * (-s2_sl + s1_sl) * Ka_sl / ((1.0 + ksat * exp((-1.0 + nu) * FoRT * V_m)) * s3_sl)

expressions("I_PCa")
I_pCa = g_pCa * Q10pCa ** Qpow * (csl * csl) / (KmPCa * KmPCa + csl * csl)

expressions("I_CaBK")
I_bCa = g_bCa * (-eca_sl + V_m)

expressions("I_f")
xf_inf = 1.0 / (1.0 + 5956538.01318462 * exp(0.2 * V_m))
tau_xf = 1900.0 * Q10f ** (-Qpow) / (1.0 + 4.48168907033806 * exp(0.1 * V_m))
dxf_dt = (-xf + xf_inf) / tau_xf
I_f = g_f * (-E_f + V_m) * xf

expressions("Na Concentrations")
I_Na_tot = 3.0 * I_NaCa + 3.0 * I_NaK + 0.3293 * I_f + I_Na + I_NaL
J_Na = -Cm * chi * I_Na_tot / Frdy
dNa_i_dt = J_Na

expressions("Ca Fluxes")
J_CaL = -Cm * chi * I_CaL / (2.0 * Frdy)
J_pCa = -Cm * chi * I_pCa / (2.0 * Frdy)
J_bCa = -Cm * chi * I_bCa / (2.0 * Frdy)
J_NaCa = Cm * chi * I_NaCa / Frdy
J_e_sl = J_NaCa + J_bCa + J_pCa
J_SERCA = J_SERCA_bar * Q10SERCA ** Qpow * (cc * cc / (K_c * K_c) - cn * cn / (K_n * K_n)) / (1.0 + cc * cc / (K_c * K_c) + cn * cn / (K_n * K_n))
J_n_s = alpha_n_s * (-cs + cn)
J_sl_c = alpha_sl_c * (-cc + csl)
J_d_c = alpha_d_c * (-cc + cd)

expressions("RyRs")
p = 1.0 / (1.0 + K_RyR * K_RyR * K_RyR / (cd * cd * cd))
J_RyR_active = alpha_RyR * (-csl + cs) * p * r_RyR
J_leak = alpha_RyR * gamma_RyR * (-csl + cs)
dr_RyR_dt = -J_RyR_active / beta_RyR + eta_RyR * (1.0 - r_RyR) / p
J_RyR = J_RyR_active + J_leak

expressions("Ca Buffers")
J_c_b = Vc * (-k_off_c * bc + k_on_c * (B_tot_c - bc) * cc)
J_d_b = Vd * (-k_off_d * bd + k_on_d * (B_tot_d - bd) * cd)
J_s_b = Vs * (-k_off_s * bs + k_on_s * (B_tot_s - bs) * cs)
J_sl_b = Vsl * (-k_off_sl * bsl + k_on_sl * (B_tot_sl - bsl) * csl)

expressions("Ca Concentrations")
dcn_dt = 1.0 * (-J_n_s + J_SERCA) / Vn
dcc_dt = 1.0 * (-J_SERCA - J_c_b + J_d_c + J_sl_c) / Vc
dcd_dt = 1.0 * (-J_d_b - J_d_c + J_CaL) / Vd
dcsl_dt = 1.0 * (-J_sl_b - J_sl_c + J_RyR + J_e_sl) / Vsl
dcs_dt = 1.0 * (-J_RyR - J_s_b + J_n_s) / Vs

expressions("Ca Buffer Concentrations")
dbc_dt = 1.0 * J_c_b / Vc
dbd_dt = 1.0 * J_d_b / Vd
dbs_dt = 1.0 * J_s_b / Vs
dbsl_dt = 1.0 * J_sl_b / Vsl

expressions("Membrane potential")
i_Stim = Conditional(Lt(V_m, -40.0), 1.0, 0.0) * Conditional(And(Le(time - stim_period * floor(time / stim_period), stim_duration + stim_start), Ge(time - stim_period * floor(time / stim_period), stim_start)), -stim_amplitude, 0.0)
I_tot = I_CaL + I_K1 + I_Kr + I_Ks + I_Na + I_NaCa + I_NaK + I_NaL + I_bCa + I_bCl + I_f + I_pCa + I_to
dV_m_dt = -I_tot - i_Stim

